+        return getMessagesController().selectedDialogFilter[dialogsType - 7];
+    }
+
+    private boolean shouldShowBotsFolderStore(MessagesController.DialogFilter filter) {
+        return BotsFolderViewHelper.isBotsOnlyFilter(filter)
+                && BotsFolderViewHelper.isStoreMode()
+                && !searching
+                && !searchIsShowed
