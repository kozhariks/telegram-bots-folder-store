+    private void attachBotsFolderStoreView(ViewPage page, Context context) {
+        if (page == null || page.botsStoreView != null || context == null) {
+            return;
+        }
+        page.botsStoreView = new BotsFolderStoreView(context, currentAccount, resourceProvider, new BotsFolderStoreView.Callback() {
+            @Override
+            public void onOpenBot(TLRPC.User bot) {
+                getMessagesController().openApp(DialogsActivity.this, bot, null, 0, null);
+            }
+
+            @Override
+            public void onOpenBotChat(TLRPC.User bot) {
+                if (bot == null) {
+                    return;
+                }
+                Bundle args = new Bundle();
+                args.putLong("user_id", bot.id);
+                presentFragment(new ChatActivity(args));
+            }
+        });
+        page.botsStoreView.setOnScrollInvalidate(() -> {
+            invalidateScrollY = true;
+            if (fragmentView != null) {
+                fragmentView.invalidate();
+            }
+        });
+        page.botsStoreView.getGridView().addOnScrollListener(new RecyclerView.OnScrollListener() {
+            private boolean wasManualScroll;
+            private int prevPosition = -1;
+            private int prevTop;
+            private boolean scrollUpdated;
+
+            @Override
+            public void onScrollStateChanged(RecyclerView recyclerView, int newState) {
+                if (newState == RecyclerView.SCROLL_STATE_DRAGGING) {
+                    wasManualScroll = true;
+                    scrollingManually = true;
+                } else {
+                    scrollingManually = false;
+                }
+                if (newState == RecyclerView.SCROLL_STATE_IDLE) {
+                    wasManualScroll = false;
+                }
+            }
+
+            @Override
+            public void onScrolled(RecyclerView recyclerView, int dx, int dy) {
+                if (fragmentView instanceof ContentView) {
+                    ((ContentView) fragmentView).updateBlurContent();
+                }
+                blur3_InvalidateBlur();
+                invalidateScrollY = true;
+                if (fragmentView != null) {
+                    fragmentView.invalidate();
+                }
+                if (!wasManualScroll || recyclerView.getChildCount() <= 0) {
+                    return;
+                }
+                int firstVisiblePosition = -1;
+                for (int i = 0; i < recyclerView.getChildCount(); i++) {
+                    int position = recyclerView.getChildAdapterPosition(recyclerView.getChildAt(i));
+                    if (position >= 0 && (firstVisiblePosition == -1 || position < firstVisiblePosition)) {
+                        firstVisiblePosition = position;
+                    }
+                }
+                if (firstVisiblePosition == RecyclerView.NO_POSITION || firstVisiblePosition < 0) {
+                    return;
+                }
+                RecyclerView.ViewHolder holder = recyclerView.findViewHolderForAdapterPosition(firstVisiblePosition);
+                int firstViewTop = holder != null ? holder.itemView.getTop() : 0;
+                boolean goingDown;
+                boolean changed = true;
+                if (prevPosition == firstVisiblePosition) {
+                    goingDown = firstViewTop < prevTop;
+                    changed = Math.abs(prevTop - firstViewTop) > 1;
+                } else {
+                    goingDown = firstVisiblePosition > prevPosition;
+                }
+                if (changed && scrollUpdated && (goingDown || scrollingManually)) {
+                    hideFloatingButton(goingDown);
+                }
+                prevPosition = firstVisiblePosition;
+                prevTop = firstViewTop;
+                scrollUpdated = true;
+            }
+        });
+        page.botsStoreView.setVisibility(View.GONE);
+        page.addView(page.botsStoreView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT));
+    }
+
