+
+    private void updateBotsFolderStoreMode() {
+        if (viewPages == null) {
+            return;
+        }
+        for (int i = 0; i < viewPages.length; i++) {
+            if (viewPages[i] != null) {
+                updateBotsFolderStoreModeForPage(viewPages[i], getFilterForPage(viewPages[i]));
+            }
+        }
+    }
+
+    private void updateBotsFolderStoreMode(MessagesController.DialogFilter filter) {
+        if (viewPages == null || viewPages.length == 0 || viewPages[0] == null) {
+            return;
+        }
+        updateBotsFolderStoreModeForPage(viewPages[0], filter);
+    }
+
+    private void updateBotsFolderStoreModeForPage(ViewPage page, MessagesController.DialogFilter filter) {
+        if (page == null || page.botsStoreView == null || page.listView == null) {
+            return;
+        }
+        final boolean showStore = shouldShowBotsFolderStore(filter);
+        if (showStore) {
+            final boolean becameVisible = page.botsStoreView.getVisibility() != View.VISIBLE;
+            // Keep listView in hierarchy (INVISIBLE) so ViewPage swipe geometry stays stable,
+            // but draw the desktop grid as the page content — sibling of listView, not overlay.
+            page.listView.setVisibility(View.INVISIBLE);
+            page.listView.setAlpha(0f);
+            if (page.progressView != null) {
+                page.progressView.setVisibility(View.GONE);
+            }
+            page.botsStoreView.setVisibility(View.VISIBLE);
+            // Keep hidden list scrolled with chrome so leaving Apps does not expand search.
+            if (page.layoutManager != null) {
+                page.layoutManager.scrollToPositionWithOffset(0, (int) scrollYOffset);
+            }
+            if (becameVisible) {
+                page.botsStoreView.onShown((int) scrollYOffset);
+            }
+            syncBotsFolderStorePaddings(page, true);
+            if (becameVisible) {
+                final ViewPage storePage = page;
+                page.botsStoreView.post(() -> {
+                    if (storePage.botsStoreView != null
+                            && storePage.botsStoreView.getVisibility() == View.VISIBLE) {
+                        syncBotsFolderStorePaddings(storePage, true);
+                    }
+                });
+            }
+        } else {
+            final boolean wasStore = page.botsStoreView.getVisibility() == View.VISIBLE;
+            page.botsStoreView.setVisibility(View.GONE);
+            page.listView.setVisibility(View.VISIBLE);
+            page.listView.setAlpha(1f);
+            if (wasStore && page.layoutManager != null) {
+                page.layoutManager.scrollToPositionWithOffset(0, (int) scrollYOffset);
+            }
+        }
+    }
+
+    private void syncBotsFolderStorePaddings() {
+        if (viewPages == null) {
+            return;
+        }
+        for (int i = 0; i < viewPages.length; i++) {
+            if (viewPages[i] != null && viewPages[i].botsStoreView != null
+                    && viewPages[i].botsStoreView.getVisibility() == View.VISIBLE) {
+                syncBotsFolderStorePaddings(viewPages[i]);
+            }
+        }
+    }
+
+    private void syncBotsFolderStorePaddings(ViewPage page) {
+        syncBotsFolderStorePaddings(page, false);
+    }
+
+    /**
+     * @param alignToScrollY when true, pin grid to current {@link #scrollYOffset} (like dialogs list).
+     *                       Never derive offset from chrome.getY() — that expands search on each swipe.
+     */
+    private void syncBotsFolderStorePaddings(ViewPage page, boolean alignToScrollY) {
+        if (page == null || page.botsStoreView == null || page.listView == null
+                || page.botsStoreView.getVisibility() != View.VISIBLE) {
+            return;
+        }
+        // DialogsRecyclerView is BlurredRecyclerView: getPaddingTop() == topPadding + blurTopPadding
+        // with topMargin = -blurTopPadding. Grid uses plain topPadding + 8dp visual inset.
+        final int top = page.listView.topPadding + AndroidUtilities.dp(8);
+        final int bottom = page.listView.bottomPadding > 0
+                ? page.listView.bottomPadding
+                : page.listView.getPaddingBottom();
+        final int prevTop = page.botsStoreView.getGridView() != null
+                ? page.botsStoreView.getGridView().getPaddingTop()
+                : -1;
+        page.botsStoreView.syncListPaddings(top, bottom);
+        if (alignToScrollY || prevTop != top) {
+            // Same contract as dialogs list: item at paddingTop + scrollYOffset.
+            // Extra 8dp lives in padding, so scrollY math stays stable (no chrome drift).
+            page.botsStoreView.syncScrollToOffset((int) scrollYOffset);
+        }
     }
 
